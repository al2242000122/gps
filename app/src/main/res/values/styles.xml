<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.GpsMocker" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="colorPrimary">@color/brand</item>
        <item name="colorOnPrimary">@color/on_brand</item>
        <item name="colorPrimaryContainer">@color/brand_soft</item>
        <item name="colorOnPrimaryContainer">@color/on_brand_soft</item>
        <item name="colorSecondary">@color/brand</item>
        <item name="colorSecondaryContainer">@color/brand_soft</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorSurfaceContainer">@color/surface</item>
        <item name="colorSurfaceContainerLow">@color/surface</item>
        <item name="colorSurfaceContainerHigh">@color/surface_soft</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorSurfaceVariant">@color/surface_soft</item>
        <item name="colorOnSurfaceVariant">@color/ink_muted</item>
        <item name="colorOutline">@color/outline</item>
        <item name="colorError">@color/danger</item>
        <item name="elevationOverlayEnabled">false</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <style name="Widget.GpsMocker.IconButton" parent="Widget.Material3.Button.IconButton">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="iconTint">?attr/colorOnSurfaceVariant</item>
        <item name="iconSize">24dp</item>
        <item name="android:padding">12dp</item>
    </style>

    <style name="Widget.GpsMocker.ToolButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">12sp</item>
        <item name="iconSize">20dp</item>
        <item name="iconPadding">5dp</item>
        <item name="android:paddingLeft">8dp</item>
        <item name="android:paddingRight">8dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>
</resources>
